# =====================================================================
#  Configuration Apache - securite et page d'accueil
# =====================================================================

# La page d'accueil du site est le front controller PHP.
DirectoryIndex index.php

# Empeche le listing des dossiers.
Options -Indexes

# --- Bloque l'acces direct aux dossiers internes de l'application ---
# (le code reste lisible dans le depot, mais inaccessible par le navigateur)
RedirectMatch 403 ^/(src|config|sql)(/.*)?$

# --- Bloque les fichiers sensibles (caches, exemples, SQL...) ---
<FilesMatch "(^\.|\.(sql|md|example\.php|gitignore|yml)$)">
    Require all denied
</FilesMatch>

# --- En-tetes de securite HTTP ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
